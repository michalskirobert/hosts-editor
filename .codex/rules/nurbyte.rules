# Supplementary prompts outside the sandbox; not an exhaustive security boundary.
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
prefix_rule(pattern = ["git", "merge"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
