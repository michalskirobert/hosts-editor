prefix_rule(pattern = ["git", "tag"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
prefix_rule(pattern = ["gh", "release"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
prefix_rule(pattern = ["gh", "api"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
prefix_rule(pattern = ["vercel"], decision = "prompt", justification = "Wymagane zatwierdzenie działania zewnętrznego lub zmiany historii.")
