{
  "name": "hosts-editor",
  "version": "2.3.0",
  "private": true,
  "description": "Cross-platform hosts editor by NurByte",
  "author": {
    "name": "Robert Michalski",
    "email": "robertmichalski@nurbyte.dev",
    "url": "https://nurbyte.dev"
  },
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "dist": "yarn build && electron-builder --x64 --arm64 --publish never",
    "dist:mac": "yarn build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "yarn build && electron-builder --win --x64 --arm64 --publish never",
    "dist:linux": "yarn build && electron-builder --linux --x64 --arm64 --publish never",
    "release": "yarn build && dotenv -e .env -- electron-builder --x64 --arm64 --publish always",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:linux": "yarn release --linux --x64 --arm64",
    "release:mac": "yarn release --mac --x64 --arm64",
    "release:win": "yarn release --win --x64 --arm64",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.16",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv-cli": "^11.0.0",
    "electron": "44.4.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5"
  }
}
